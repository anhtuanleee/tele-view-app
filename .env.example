# Token bot lấy từ @BotFather
BOT_TOKEN=

# Chỉ phục vụ các chat này (để trống = mọi chat). Lấy id bằng @userinfobot hoặc xem log.
ALLOWED_CHAT_IDS=

# Local Bot API Server để gửi video tới 2GB (mặc định giới hạn 50MB)
# BOT_API_URL=http://localhost:8081

# Cookie cho yt-dlp, Douyin bắt buộc cần. Chọn 1 trong 2:
# COOKIES_FILE=cookies.txt
# COOKIES_FROM_BROWSER=chrome

# Để trống thì tự tạo tài khoản  Telegraph và lưu vào data/telegraph_token
TELEGRAPH_TOKEN=

# Số video xử lý cùng lúc
MAX_JOBS=2
DATA_DIR=data

# Dịch caption và tiêu đề sang ngôn ngữ này (qua Google Translate miễn phí). Để trống = tắt dịch
TRANSLATE_TO=vi
